  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b42226b7ba25faf4f935ba16dd43dd05, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EducationPanelController
  titleText: {fileID: 1738460067}
  contentText: {fileID: 1827936200}
  previousButton: {fileID: 944090587}
  nextButton: {fileID: 461735036}
  pages:
  - title: "\uC804\uC790\uAE30 \uC720\uB3C4\uB780?"
    content: "\uCF54\uC77C\uC744 \uC9C0\uB098\uB294 \uC790\uAE30\uC120\uC18D\uC774
      \uBCC0\uD560 \uB54C \uC720\uB3C4\uC804\uC555\uC774 \uC0DD\uAE41\uB2C8\uB2E4.
      \uC790\uC11D\uC774 \uBA48\uCD94\uAC70\uB098 \uC120\uC18D \uBCC0\uD654\uAC00
      \uC791\uC740 \uC911\uC559 \uAD6C\uAC04\uC5D0\uC11C\uB294 \uBC1C\uC804\uD558\uC9C0
      \uC54A\uC2B5\uB2C8\uB2E4. \uC785\uAD6C\uC640 \uCD9C\uAD6C\uB97C \uC9C0\uB098\uB3C4\uB85D
      \uC6C0\uC9C1\uC5EC \uBCF4\uC138\uC694."
  - title: "\uCF54\uC77C\uACFC \uBC1C\uC804\uB7C9"
    content: "\uCF54\uC77C \uAC10\uC740 \uC218 \uC5C5\uADF8\uB808\uC774\uB4DC\uB294
      \uBC1C\uC804 \uAE30\uBCF8\uCE58\uB97C \uC62C\uB9BD\uB2C8\uB2E4. \uB808\uBCA8
      1\uBD80\uD130 \uD604\uC7AC \uB808\uBCA8\uAE4C\uC9C0 \uB354\uD558\uC5EC 1, 3,
      6, 10, 15, 21, 28W\uB85C \uC99D\uAC00\uD569\uB2C8\uB2E4. \uCF54\uC77C \uC804\uC120
      \uAD75\uAE30 \uC5C5\uADF8\uB808\uC774\uB4DC\uB294 \uCF54\uC77C \uB192\uC774\uC640
      \uBC1C\uC804 \uC778\uC2DD\uBC94\uC704\uB97C \uB808\uBCA8\uB9C8\uB2E4 \uAE30\uBCF8
      \uB192\uC774\uC758 10%\uC529 \uB298\uB9BD\uB2C8\uB2E4. \uCF54\uC77C \uC7AC\uC9C8
      \uAC1C\uC120\uC740 \uBC1C\uC804\uB7C9\uC5D0 \uACF1\uD574\uC9D1\uB2C8\uB2E4."
  - title: "\uC790\uC11D\uC758 \uC6C0\uC9C1\uC784"
    content: "\uC790\uC11D\uC744 \uBC1C\uC804 \uC601\uC5ED\uC758 \uD55C\uCABD \uB05D\uC5D0\uC11C
      \uBC18\uB300\uCABD \uB05D\uAE4C\uC9C0 \uC6C0\uC9C1\uC774\uC138\uC694. \uD1B5\uACFC\uAC00
      \uB05D\uB098\uBA74 \uBAA8\uC740 \uC804\uB825\uC774 \uD55C \uBC88\uC5D0 \uC9C0\uAE09\uB418\uACE0
      \uB178\uB780 \uAE00\uC528\uB85C \uD45C\uC2DC\uB429\uB2C8\uB2E4. \uBE60\uB974\uAC8C
      \uC6C0\uC9C1\uC77C\uC218\uB85D \uCD9C\uB825\uC774 \uCEE4\uC9D1\uB2C8\uB2E4.
      WPS\uB294 \uC644\uB8CC\uD55C \uD1B5\uACFC\uC758 \uD3C9\uADE0 \uBC1C\uC804\uB7C9\uC774\uBA70
      \uB2E4\uC74C \uD1B5\uACFC\uAE4C\uC9C0 \uC720\uC9C0\uB429\uB2C8\uB2E4. \uC911\uAC04\uC5D0
      \uB418\uB3CC\uC544\uAC00\uBA74 \uC774\uBC88 \uC2DC\uB3C4\uB294 \uCDE8\uC18C\uB429\uB2C8\uB2E4."
  learningContent: {fileID: 11400000, guid: 5c0d932b762ef2a4aa4d23a3b03f999c, type: 2}
