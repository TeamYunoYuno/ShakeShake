  m_text: "\uC804\uC790\uAE30 \uC720\uB3C4\uB294 \uCF54\uC77C\uC744 \uD1B5\uACFC\uD558\uB294
    \uC790\uAE30\uC120\uC18D\uC774 \uBCC0\uD560 \uB54C \uCF54\uC77C\uC5D0 \uC720\uB3C4
    \uAE30\uC804\uB825\uC774 \uBC1C\uC0DD\uD558\uB294 \uD604\uC0C1\uC774\uB2E4.\n\n\uC790\uAE30\uC120\uC18D\uC740
    \uD2B9\uC815 \uBA74\uC744 \uD1B5\uACFC\uD558\uB294 \uC790\uAE30\uC7A5\uC758 \uC591\uC744
    \uC758\uBBF8\uD55C\uB2E4. \uC790\uAE30\uC120\uC18D\uC774 \uBCC0\uD558\uACE0 \uCF54\uC77C\uC774
    \uB2EB\uD78C \uD68C\uB85C\uB97C \uC774\uB8E8\uACE0 \uC788\uB2E4\uBA74 \uC804\uB958\uAC00
    \uD750\uB97C \uC218 \uC788\uB294\uB370, \uC774\uB97C \uC720\uB3C4 \uC804\uB958\uB77C\uACE0
    \uD55C\uB2E4.\n\n\uC720\uB3C4 \uC804\uB958\uC758 \uC138\uAE30\uC5D0 \uC601\uD5A5\uC744
    \uC8FC\uB294 \uB300\uD45C\uC801\uC778 \uC694\uC778\uC740 \uB2E4\uC74C\uACFC \uAC19\uB2E4.\n\n-
    \uC790\uC11D\uC758 \uC774\uB3D9 \uC18D\uB3C4: \uC790\uC11D\uC744 \uBE60\uB974\uAC8C
    \uC6C0\uC9C1\uC774\uBA74 \uC790\uAE30\uC120\uC18D\uC774 \uB354 \uBE60\uB974\uAC8C
    \uBCC0\uD558\uC5EC \uC720\uB3C4 \uC804\uB958\uAC00 \uAC15\uD574\uC9C8 \uC218
    \uC788\uB2E4.\n- \uCF54\uC77C\uC758 \uAC10\uC740 \uC218: \uCF54\uC77C\uC744 \uB9CE\uC774
    \uAC10\uC744\uC218\uB85D \uB354 \uD070 \uC720\uB3C4 \uAE30\uC804\uB825\uC744
    \uC5BB\uC744 \uC218 \uC788\uB2E4.\n- \uC790\uC11D\uC758 \uC138\uAE30: \uC790\uAE30\uC7A5\uC774
    \uAC15\uD55C \uC790\uC11D\uC744 \uC0AC\uC6A9\uD558\uBA74 \uC790\uAE30\uC120\uC18D\uC758
    \uBCC0\uD654\uB97C \uD06C\uAC8C \uB9CC\uB4E4 \uC218 \uC788\uB2E4.\n\n\uB2E8,
    \uC2E4\uC81C \uC720\uB3C4 \uC804\uB958\uC758 \uC138\uAE30\uB294 \uCF54\uC77C\uACFC
    \uD68C\uB85C\uC758 \uC800\uD56D\uC5D0\uB3C4 \uC601\uD5A5\uC744 \uBC1B\uB294\uB2E4."
  m_isRightToLeft: 0
